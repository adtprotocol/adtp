# Side A (Stratus). Copy to .env and fill in.

# The domain in the addresses: agent@<ADTP_DOMAIN>, dylan@<ADTP_DOMAIN>.
ADTP_DOMAIN=stratuslabs.com

# The hostname this node is served at. Its DNS A/AAAA record must point at this machine.
ADTP_HOST=adtp.stratuslabs.com

# Two tokens guard the node's local API. Neither is set here on purpose; add random ones to your .env with:
#   echo "ADTP_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
#   echo "ADTP_AGENT_TOKEN=$(openssl rand -hex 24)" >> .env
# The admin token is for you (the admin pages, the requests tray, delegations).
# The agent token is the one to give the Stratus agent's ADTP tool: it can send and read for agent@ and nothing else.

# Who the demo message goes to: Side B's address.
DEMO_TO=echo@demo.adtp.dev

# The node's own port on this host. Kept on localhost; the outside world comes in through HTTPS.
# ADTP_BIND=127.0.0.1
# ADTP_HTTP_PORT=7387
