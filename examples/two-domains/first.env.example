# The example.com server: agent@example.com. Copy to .env on that server.

# The domain in the address, and the address itself: <ADTP_LOCAL>@<ADTP_DOMAIN>.
ADTP_DOMAIN=example.com
ADTP_LOCAL=agent
ADTP_TYPE=agent

# The hostname this node is served at. Its DNS A/AAAA record must point at this
# server. A subdomain keeps example.com itself free for a website.
ADTP_HOST=adtp.example.com

# Show this address in example.com's public directory, with this description.
ADTP_LISTED=true
ADTP_DESCRIPTION=A test address for trying ADTP. Messages sent here are read by a person.

# Two tokens guard the node's local API. Neither is set here on purpose; add random ones to your .env with:
#   echo "ADTP_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
#   echo "ADTP_AGENT_TOKEN=$(openssl rand -hex 24)" >> .env
# The admin token signs you in at https://<ADTP_HOST>/admin and is what the adtp command uses.
# The agent token is the one to give an agent that sends and reads as agent@.

# The node's own port on this server. Kept on localhost; the outside world comes in through HTTPS.
# ADTP_BIND=127.0.0.1
# ADTP_HTTP_PORT=7387
