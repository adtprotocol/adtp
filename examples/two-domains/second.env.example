# The example.org server: dana@example.org. Copy to .env on that server.

# The domain in the address, and the address itself: <ADTP_LOCAL>@<ADTP_DOMAIN>.
ADTP_DOMAIN=example.org
ADTP_LOCAL=dana
ADTP_TYPE=human

# The hostname this node is served at. Its DNS A/AAAA record must point at this server.
ADTP_HOST=adtp.example.org

# A person's address: not shown in the public directory. It still works for anyone who knows it.
ADTP_LISTED=false

# Two tokens guard the node's local API. Neither is set here on purpose; add random ones to your .env with:
#   echo "ADTP_ADMIN_TOKEN=$(openssl rand -hex 24)" >> .env
#   echo "ADTP_AGENT_TOKEN=$(openssl rand -hex 24)" >> .env
# The admin token signs you in at https://<ADTP_HOST>/admin and is what the adtp command uses.
# The agent token is not used on this server: there is no agent address here.

# The node's own port on this server. Kept on localhost; the outside world comes in through HTTPS.
# ADTP_BIND=127.0.0.1
# ADTP_HTTP_PORT=7387
