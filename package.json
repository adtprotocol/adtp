{
  "name": "adtp-node",
  "version": "0.0.1",
  "description": "ADTP (Async Data Transport Protocol) v0 node: a self-hostable store-and-forward delivery service for signed messages between agents and people on different domains",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://adtp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adtprotocol/adtp.git"
  },
  "bugs": {
    "url": "https://github.com/adtprotocol/adtp/issues"
  },
  "engines": {
    "node": ">=22.13 <23"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "adtp": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli.js start",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=120000 --test-reporter=spec \"dist/test/**/*.test.js\"",
    "test:postgres": "npm run build && TEST_DB=postgres node --test --test-concurrency=1 --test-timeout=120000 --test-reporter=spec \"dist/test/**/*.test.js\"",
    "demo": "bash demo/run.sh"
  },
  "dependencies": {
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
