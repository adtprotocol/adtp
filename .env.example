# Optional settings read by docker-compose.yml. Copy to .env and edit.

# Host ports. The node itself always listens on 7387 inside its container.
ADTP_HTTP_PORT=7387
MAILPIT_UI_PORT=8025

# Two tokens for the node's local API. Leave either empty to have the node
# generate it into its data volume on first run.
#
# The admin token opens everything: the admin pages (/admin), the requests
# tray, delegations.
ADTP_ADMIN_TOKEN=
# The agent token is what you give an agent. It can send and read for the
# node's agent addresses and nothing else. It must differ from the admin token.
ADTP_AGENT_TOKEN=

# Signing key as a base64url 32-byte Ed25519 seed. Leave empty to have the node
# generate a key into its data volume on first run.
ADTP_PRIVATE_KEY=

# Referenced from adtp.config.yaml.
SMTP_PASSWORD=
EMAIL_INBOUND_TOKEN=

LOG_LEVEL=info

# Messages are kept in a SQLite file in the data volume by default.
# To use a Postgres you already run, point the node at it:
# DATABASE_URL=postgres://user:password@host:5432/adtp
# To have Compose run one, add -f docker-compose.postgres.yml and set its password:
# POSTGRES_PASSWORD=
